{
  "name": "puerto-rican-mami-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "new-site": "node tools/new-site.mjs",
    "list-sites": "node tools/list-sites.mjs",
    "setup:worktree": "node tools/setup-worktree.mjs",
    "test:tools": "node --test tools/tools.test.mjs",
    "check:packages": "pnpm --filter @shipwords/core --filter @shipwords/jobs check",
    "check:template": "pnpm --filter ./templates/ai-site check",
    "dev": "pnpm --filter ./sites/puerto-rican-mami-ai dev",
    "build": "pnpm --filter ./sites/puerto-rican-mami-ai build",
    "check": "pnpm --filter ./sites/puerto-rican-mami-ai check",
    "test": "pnpm --filter ./sites/puerto-rican-mami-ai test",
    "deploy": "pnpm --filter ./sites/puerto-rican-mami-ai run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "6.0.3"
  }
}
